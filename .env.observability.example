# Optional machine-local defaults for yarn observability:*.
# Copy to .env.observability (ignored by Git). CLI > shell env > this file.
# Paths are relative to the checkout; ~/ is supported. No shell expansion here.
ARTGOD_OBSERVABILITY_PROJECT_NAME=artgod-observability
ARTGOD_OBSERVABILITY_LOGS_DIR=tmp/logs
ARTGOD_OBSERVABILITY_GRAFANA_PORT=42735
ARTGOD_OBSERVABILITY_PROMETHEUS_PORT=42734
ARTGOD_OBSERVABILITY_LOKI_PORT=42730
ARTGOD_OBSERVABILITY_TEMPO_PORT=42731
ARTGOD_OBSERVABILITY_OTLP_PORT=42732
ARTGOD_OBSERVABILITY_PYROSCOPE_PORT=42733
# Match ports configured in the app; comma-separated NAME=PORT assignments.
# ARTGOD_OBSERVABILITY_METRICS_PORTS=bidding-bot=42754,sync-worker=42842
