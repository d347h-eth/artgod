{
    "name": "artgod",
    "version": "0.1.3-alpha",
    "private": true,
    "type": "module",
    "author": "d347h.eth <wagdie.dev@gmail.com>",
    "license": "AGPL-3.0-only",
    "packageManager": "yarn@4.12.0",
    "engines": {
        "node": "24.3.0"
    },
    "workspaces": [
        "backend",
        "database",
        "frontend",
        "indexer",
        "shared",
        "trading"
    ],
    "resolutions": {
        "undici@npm:^6.25.0": "npm:6.28.1",
        "undici@npm:^7.25.0": "npm:7.29.1",
        "ws@npm:8.17.1": "npm:8.21.0",
        "ws@npm:8.20.1": "npm:8.21.0",
        "cookie@npm:^0.6.0": "npm:0.7.2",
        "devalue@npm:^5.8.1": "npm:5.9.3",
        "@grpc/grpc-js@npm:^1.11.1": "npm:1.14.5",
        "@grpc/grpc-js@npm:^1.14.3": "npm:1.14.5",
        "brace-expansion@npm:^2.0.1": "npm:2.1.7",
        "brace-expansion@npm:^2.0.2": "npm:2.1.7",
        "brace-expansion@npm:^5.0.5": "npm:5.0.12",
        "fast-uri@npm:^3.0.0": "npm:3.1.8",
        "fast-uri@npm:^3.0.1": "npm:3.1.8",
        "fast-uri@npm:^4.0.0": "npm:4.1.5",
        "shell-quote@npm:1.9.0": "npm:1.11.0",
        "source-map-js@npm:^1.2.1": "npm:1.2.2",
        "postcss-selector-parser@npm:^7.0.0": "npm:7.1.6",
        "postcss-selector-parser@npm:6.0.10": "npm:7.1.6"
    },
    "scripts": {
        "dev": "./scripts/dev.sh",
        "storage:recover": "node --import tsx ./indexer/src/runtime/sqlite-market-data-maintenance.ts",
        "dev:indexer": "./scripts/indexer-dev.sh",
        "dev:composition": "yarn dev:composition:pruned",
        "dev:desktop": "yarn dev:desktop:pruned",
        "dev:composition:pruned": "yarn build:userland && yarn build:desktop-runtime && yarn build:desktop-runtime-resources && yarn dev:desktop:pruned",
        "dev:desktop:pruned": "node ./scripts/build/build-tauri.mjs dev --no-watch",
        "dev:composition:observability": "node ./scripts/build/dev-local-desktop.mjs",
        "tauri": "tauri",
        "build": "node ./scripts/build/build-frontend-target.mjs web",
        "build:web": "node ./scripts/build/build-frontend-target.mjs web",
        "build:userland": "node ./scripts/build/build-frontend-target.mjs userland",
        "build:admin": "node ./scripts/build/build-frontend-target.mjs admin",
        "build:desktop": "node ./scripts/build/build-frontend-target.mjs admin",
        "build:desktop:no-bundle": "node ./scripts/build/build-tauri.mjs --no-bundle --ci",
        "build:desktop:linux-bundle": "node ./scripts/build/prepare-tauri-linux-bundler-tools.mjs --build",
        "build:desktop:local": "node ./scripts/build/build-local-desktop.mjs",
        "build:desktop:local:bundle": "node ./scripts/build/build-local-desktop.mjs --bundle",
        "test:desktop:local": "node --test scripts/build/local-desktop.test.mjs",
        "check:desktop:local:dev-build": "node scripts/build/verify-local-desktop-dev.mjs",
        "test:desktop:local:exporters": "node scripts/build/test-local-desktop-observability.mjs",
        "check:desktop:local": "node scripts/build/verify-local-desktop-runtime.mjs",
        "config:generate:desktop-local": "node scripts/config/generate-local-desktop-admin-fixture.mjs",
        "config:check:desktop-local": "node scripts/config/generate-local-desktop-admin-fixture.mjs --check",
        "build:runtime": "node ./scripts/build/build-runtime-artifacts.mjs",
        "build:desktop-runtime": "node ./scripts/build/build-runtime-artifacts.mjs --profile desktop",
        "build:sqlite-native": "node ./scripts/build/build-sqlite-native-binding.mjs",
        "build:desktop-runtime-resources": "node ./scripts/build/prepare-desktop-runtime-resources.mjs",
        "build:desktop-sidecars": "node ./scripts/build/prepare-desktop-sidecars.mjs",
        "check:desktop-runtime-resources": "node ./scripts/build/verify-staged-desktop-runtime-dependencies.mjs && node ./scripts/build/verify-staged-desktop-nats-loopback.mjs",
        "check:desktop-no-bundle-runtime": "node ./scripts/build/verify-tauri-no-bundle-runtime.mjs",
        "check:linux-release-build": "node ./scripts/build/verify-linux-release-build.mjs",
        "check:linux-bundled-runtime": "node ./scripts/build/verify-linux-bundled-runtime.mjs",
        "prepare:tauri-linux-tools": "node ./scripts/build/prepare-tauri-linux-bundler-tools.mjs",
        "config:generate": "node ./scripts/config/generate-env-example.mjs",
        "config:check": "node ./scripts/config/generate-env-example.mjs --check",
        "check:docs": "node ./scripts/docs/verify-documentation.mjs",
        "test:docs": "node --test ./scripts/docs/verify-documentation.test.mjs",
        "security:yarn:verify-lockfile": "yarn install --immutable --refresh-lockfile --check-resolutions --mode=skip-build",
        "security:yarn:audit": "yarn npm audit -A -R --severity high",
        "security:yarn:verify": "yarn security:yarn:verify-lockfile && yarn security:yarn:audit",
        "cargo:update-aged": "node ./scripts/security/cargo-update-aged.mjs",
        "cargo:age-gate": "node ./scripts/security/cargo-age-gate.mjs",
        "observability:fix-permissions": "node ./scripts/observability/ensure-grafana-provisioning-permissions.mjs",
        "observability:bidding-dashboard:generate": "tsx ./scripts/observability/generate-bidding-runtime-dashboard.ts",
        "observability:bidding-dashboard:check": "tsx ./scripts/observability/generate-bidding-runtime-dashboard.ts --check",
        "observability:bidding-dashboard:test": "vitest run scripts/observability/generate-bidding-runtime-dashboard.test.ts",
        "observability:bidding-dashboard:test-promql": "tsx ./scripts/observability/test-bidding-runtime-promql.ts",
        "observability:up": "node ./scripts/observability/compose.mjs up",
        "observability:stop": "node ./scripts/observability/compose.mjs stop",
        "observability:down": "node ./scripts/observability/compose.mjs down",
        "check:runtime-registry": "node ./scripts/build/check-runtime-registry.mjs",
        "check:version": "node ./scripts/build/sync-version.mjs --check",
        "debug:ethereum-node": "node ./scripts/debug/ethereum-node-probe.mjs",
        "debug:bootstrap": "tsx ./scripts/debug/bootstrap-live-check.ts",
        "sync:version": "node ./scripts/build/sync-version.mjs",
        "clean:build": "node ./scripts/build/clean-build-artifacts.mjs",
        "build:frontend": "yarn build:web",
        "install:all": "yarn install && yarn workspaces foreach run install",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "yarn workspace @artgod/backend test && yarn workspace @artgod/frontend test && yarn workspace @artgod/indexer test && yarn workspace @artgod/trading test",
        "test:bidding:strategy": "vitest run --config ./vitest.bidding-strategy.config.ts --coverage",
        "test:desktop:signing": "node ./scripts/build/secret-output-redaction.test.mjs && node ./scripts/build/macos-universal-runtime.test.mjs && node ./scripts/build/macos-code-signing.test.mjs && node ./scripts/build/macos-notarization.test.mjs && node ./scripts/build/linux-gpg-signing.test.mjs",
        "test:desktop:linux-reproduction": "node ./scripts/build/reproduce-linux-release-docker.integration.test.mjs",
        "test:desktop:runtime-packaging": "node ./scripts/build/frontend-dev-process-tree.test.mjs && node ./scripts/build/project-yarn-command.test.mjs && node ./scripts/build/pinned-build-inputs.test.mjs && node ./scripts/build/desktop-runtime-inputs.test.mjs && node ./scripts/build/runtime-build-profile.test.mjs && node ./scripts/build/native-runtime-dependencies.test.mjs && node ./scripts/build/build-sqlite-native-binding.test.mjs && node ./scripts/build/desktop-runtime-dependency-staging.test.mjs && node ./scripts/build/verify-staged-desktop-runtime-dependencies.test.mjs && node ./scripts/build/linux-appimage-host-libraries.test.mjs && node ./scripts/build/verify-linux-bundled-runtime.test.mjs",
        "test:desktop:runtime-environment": "cargo test --manifest-path src-tauri/Cargo.toml --locked runtime::supervisor::tests::runtime_environment --lib -- --include-ignored",
        "test:desktop:admin-manifest": "node --test ./scripts/build/frontend-build-metadata.test.mjs && node ./scripts/build/test-desktop-admin-manifest.mjs",
        "test:desktop:listener-boundaries": "node ./scripts/build/verify-staged-desktop-nats-loopback.test.mjs && node ./scripts/build/test-desktop-listener-boundaries.mjs && yarn tsx ./scripts/build/verify-desktop-backend-loopback.ts",
        "test:desktop:release-inputs": "yarn test:desktop:runtime-packaging && node ./scripts/build/reproduce-linux-release-docker.test.mjs && node ./scripts/build/verify-linux-release-build.test.mjs && node ./scripts/build/build-tauri.test.mjs && node ./scripts/security/cargo-age-gate.test.mjs && node ./scripts/build/tauri-webview-capabilities.test.mjs && node ./scripts/build/secret-prompt-release-inputs.test.mjs && node ./scripts/build/prepare-tauri-linux-bundler-tools.test.mjs && node ./scripts/build/sync-version.test.mjs && node ./scripts/build/desktop-release-notes.test.mjs && node ./scripts/build/desktop-release-admission.test.mjs && node ./scripts/build/github-release-publication.test.mjs",
        "test:desktop:release": "yarn test:desktop:release-inputs && yarn test:desktop:signing && node ./scripts/build/github-actions-security.test.mjs",
        "test:desktop:sensitive-process": "yarn build:desktop-sidecars --profile release && node ./scripts/build/node-sensitive-process.test.mjs && cargo test --manifest-path src-tauri/crates/artgod-sensitive-process/Cargo.toml --locked && cargo test --manifest-path src-tauri/sidecars/artgod-secret-prompt/Cargo.toml --locked && cargo test --manifest-path src-tauri/Cargo.toml --locked runtime::supervisor::tests::trading_bot_node_args_disable_signal_started_inspection_exactly_once --lib -- --exact && cargo test --manifest-path src-tauri/Cargo.toml --locked runtime::supervisor::tests::key_bearing_bot_environment_is_rebuilt_from_frozen_config --lib -- --exact",
        "test:desktop:secret-prompt-parent-containment": "cargo test --manifest-path src-tauri/Cargo.toml --locked --offline wallet::infra::prompt::secret_prompt_sidecar::tests --lib && cargo test --manifest-path src-tauri/Cargo.toml --locked --offline wallet::infra::prompt::secret_prompt_sidecar::tests::export_reveal_fixture_never_survives_hard_parent_death --lib -- --ignored --exact && cargo test --manifest-path src-tauri/sidecars/artgod-secret-prompt/Cargo.toml --locked --offline",
        "test:desktop:parent-containment": "yarn test:desktop:secret-prompt-parent-containment && yarn workspace @artgod/trading test src/runtime/parent-secret-channel.test.ts && yarn build:desktop-runtime && node ./scripts/build/prepare-desktop-runtime-dependencies.mjs && cargo test --manifest-path src-tauri/Cargo.toml --locked runtime::supervisor::tests::key_bearing_bot_environment_is_rebuilt_from_frozen_config --lib -- --exact && cargo test --manifest-path src-tauri/Cargo.toml --locked runtime::supervisor::tests::stop_interrupts_a_secret_handoff_blocked_by_an_unread_pipe --lib -- --exact && cargo test --manifest-path src-tauri/crates/artgod-sensitive-process/Cargo.toml --locked tests::hard_parent_death::hard_parent_death_stops_child_pid_and_activity -- --ignored --exact && cargo test --manifest-path src-tauri/Cargo.toml --locked runtime::supervisor::tests::production_bot_exits_gracefully_and_after_hard_parent_death --lib -- --ignored --exact",
        "test:preview:attached": "yarn workspace @artgod/frontend test:preview:attached",
        "test:preview:attached:headed": "yarn workspace @artgod/frontend test:preview:attached:headed",
        "test:preview:attached:artifacts": "yarn workspace @artgod/frontend test:preview:attached:artifacts",
        "test:preview:attached:headed:artifacts": "yarn workspace @artgod/frontend test:preview:attached:headed:artifacts",
        "test:bidding:attached": "yarn workspace @artgod/frontend test:bidding:attached",
        "test:bidding:attached:headed": "yarn workspace @artgod/frontend test:bidding:attached:headed",
        "test:bidding:attached:artifacts": "yarn workspace @artgod/frontend test:bidding:attached:artifacts",
        "test:bidding:attached:headed:artifacts": "yarn workspace @artgod/frontend test:bidding:attached:headed:artifacts",
        "test:bidding:automation": "yarn workspace @artgod/frontend test:bidding:automation",
        "test:bidding:automation:headed": "yarn workspace @artgod/frontend test:bidding:automation:headed",
        "test:terraforms:media": "yarn workspace @artgod/frontend test:terraforms:media",
        "test:bidding:automation:public": "yarn workspace @artgod/frontend test:bidding:automation:public",
        "test:bidding:authorization": "yarn workspace @artgod/frontend test:bidding:authorization",
        "test:bootstrap:probe": "yarn workspace @artgod/frontend test:bootstrap:probe",
        "test:terraforms:hypercastle": "yarn workspace @artgod/frontend test:terraforms:hypercastle",
        "test:runtime:recovery": "yarn workspace @artgod/frontend test:runtime:recovery",
        "test:listings:history": "yarn workspace @artgod/frontend test:listings:history",
        "test:blockspace": "yarn workspace @artgod/frontend test:blockspace",
        "test:prices:history": "yarn workspace @artgod/frontend test:prices:history",
        "test:nats:recovery": "yarn workspace @artgod/indexer test:nats:recovery",
        "test:sqlite:recovery-runtime": "node scripts/build/test-sqlite-recovery-runtime.mjs"
    },
    "dependencies": {
        "better-sqlite3": "12.10.0",
        "dotenv": "17.4.2",
        "viem": "2.54.6"
    },
    "dependenciesMeta": {
        "better-sqlite3@12.10.0": {
            "unplugged": true
        },
        "better-sqlite3": {
            "built": true
        },
        "esbuild": {
            "built": true
        }
    },
    "devDependencies": {
        "@tauri-apps/cli": "2.11.3",
        "@types/better-sqlite3": "7.6.13",
        "@types/node": "25.9.2",
        "@vitest/coverage-v8": "4.1.11",
        "concurrently": "10.0.4",
        "esbuild": "0.28.1",
        "prettier": "3.8.3",
        "tsx": "4.22.4",
        "typescript": "6.0.3",
        "vitest": "4.1.11"
    },
    "prettier": {
        "tabWidth": 4,
        "useTabs": false
    }
}
